<header>
    <h1>Fusion Lobby Browser</h1>
    <p class="headerText">Browse lobbies without having to open BONELAB!</p>
    <div id="navigationBar">

        <a class="navigationItem" href="/" rel="noopener noreferrer">
            <i class="textIcon fa-solid fa-home"></i>
            <span class="elemContent">Home</span>
        </a>

        <a class="navigationItem" href="/faq" rel="noopener noreferrer">
            <i class="textIcon fa-solid fa-question"></i>
            <span class="elemContent">FAQ</span>
        </a>

        <a class="navigationItem" href="https://flb.fider.io/" target="_blank" rel="noopener noreferrer">
            <i class="textIcon fa-solid fa-comment"></i>
            <span class="elemContent">Feedback</span>
        </a>

        <a class="navigationItem support" href="https://ko-fi.com/hahoos" target="_blank" rel="noopener noreferrer">
            <i class="textIcon fa-solid fa-heart"></i>
            <span class="elemContent">Support</span>
        </a>

        <a class="navigationItem" href="https://github.com/FusionLobbyBrowser/Website" target="_blank"
            rel="noopener noreferrer">
            <i class="textIcon fa-brands fa-github"></i>
            <span class="elemContent">Source Code</span>
        </a>

        <div id="steamAccount">
            <a id="steamRedirect" class="navigationItem"
                href="https://fusionapi.hahoos.dev/steam/login?redirectUrl=https://fusion.hahoos.dev/preview"
                target="_blank" rel="noopener noreferrer">
                <i class="textIcon fa-brands fa-steam"></i>
                <span class="elemContent">Log in with Steam</span>
            </a>
            <div class="steamAccount hidden">
                <img src="https://avatars.steamstatic.com/57d2647b204929180f21b5a01355dcb67d5742ca_full.jpg"
                    class="steamSmall" />
                <button class="textButton steamName"><span class="elemContent">RottenCheese</span><i
                        class="fa-solid fa-caret-down"></i></button></i>
            </div>
        </div>
    </div>
    <button id="refreshButton"><i class="fa-solid fa-arrows-rotate textIcon"></i><span
            class="elemContent">Refresh</span></button>
    <button id="settingsButton"><i class="fa-solid fa-gear textIcon"></i><span
            class="elemContent">Settings</span></button>
</header>